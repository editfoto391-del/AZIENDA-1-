MONGO_URL=mongodb://localhost:27017
DB_NAME=superiqfoam
# Add the exact live frontend origin here when using a custom domain.
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
EMERGENT_LLM_KEY=replace-with-your-llm-key
INITIAL_MANUFACTURING_PASSWORD=replace-with-a-strong-password
INITIAL_WHOLESALER_PASSWORD=replace-with-a-strong-password

# S3-compatible historical backup storage. Production backups stay disabled until
# every required credential below is set and mongodump/mongorestore are available
# in the backend runtime. Do not commit real credentials.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
BACKUP_S3_PREFIX=erp-backups
